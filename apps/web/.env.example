# Gateway origin the browser talks to (the only backend surface).
NEXT_PUBLIC_API_URL=http://localhost:8080

# This app's public origin — OIDC redirect URI base and returnTo resolution.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OIDC issuer for the BFF auth routes — the gateway, which proxies
# /connect/* and /.well-known/* to the accounts service (OpenIddict).
AUTH_ISSUER=http://localhost:8080
AUTH_CLIENT_ID=datarango-web

# Set to .datarango.com in prod so the session marker spans all apps; leave
# unset for localhost.
# AUTH_COOKIE_DOMAIN=.datarango.com
